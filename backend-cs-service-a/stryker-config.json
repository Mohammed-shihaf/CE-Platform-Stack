{
  "stryker-config": {
    "project": "backend-cs-service-a.csproj",
    "test-projects": [
      "../backend-cs-service-a.Tests/backend-cs-service-a.Tests.csproj"
    ],
    "reporters": ["progress", "html", "json"],
    "output-path": "quality/stryker/report",
