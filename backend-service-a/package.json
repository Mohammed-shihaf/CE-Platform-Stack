{
  "name": "backend-service-a",
  "version": "1.0.0",
  "private": true,
  "description": "gRPC server + REST API for the Record entity, owns MongoDB 8",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node -c src/server.js",
    "lint": "eslint src/ test/",
    "test": "mocha test/**/*.test.js",
    "coverage": "nyc --reporter=cobertura mocha 'test/**/*.test.js'",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.3",
    "@grpc/proto-loader": "^0.7.13",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mongoose": "^8.7.0"
  },
  "devDependencies": {
    "@socketsecurity/cli": "^1.1.158",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/mocha-runner": "^8.6.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "git-spark": "^1.3.2",
    "gutcheck": "^0.8.0",
    "mocha": "^10.7.3",
    "mongodb-memory-server": "^10.1.2",
    "monocart-coverage-reports": "^2.13.0",
    "nyc": "^17.1.0",
    "oxlint": "^1.79.0"
  }
}
