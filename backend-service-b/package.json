{
  "name": "backend-service-b",
  "version": "1.0.0",
  "private": true,
  "description": "gRPC client of service-a; owns Elasticsearch, publishes SNS events, sends SES email",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node -c src/index.js",
    "lint": "eslint src/ test/",
    "test": "mocha test/**/*.test.js",
    "coverage": "nyc --reporter=cobertura mocha 'test/**/*.test.js'",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.677.0",
    "@aws-sdk/client-sns": "^3.677.0",
    "@elastic/elasticsearch": "^8.15.1",
    "@grpc/grpc-js": "^1.11.3",
    "@grpc/proto-loader": "^0.7.13",
    "cors": "^2.8.5",
    "express": "^4.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/mocha-runner": "^8.6.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0"
  }
}
